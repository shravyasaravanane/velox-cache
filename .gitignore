# Compiled output — Maven rebuilds this from source, so it never goes in git
target/
*.class

# Local toolchain (the Maven we downloaded) — not part of the source code
.tools/

# IDE settings
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS junk
Thumbs.db
.DS_Store

# Benchmark output (regenerated by running the benchmarks)
*.csv
!traces/*.csv

# Generated by the Maven shade plugin on every benchmark build
dependency-reduced-pom.xml

# velox-server's local, file-backed H2 database -- runtime state from running the demo,
# not source. Delete it (or point at a fresh one) to force DataSeeder to reseed.
velox-server/data/

# ...except benchmark result data, which is small and is the evidence behind the reports
!docs/benchmarks/data/*.csv
